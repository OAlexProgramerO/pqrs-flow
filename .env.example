# Copy this file to .env and adjust the values if needed.

NODE_ENV=development
PORT=3000
DB_PATH=data/pqrs.db

# New requests (POST /api/pqrs) allowed per client address in each window.
SUBMIT_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_WINDOW_MINUTES=15

# Only when a reverse proxy (Nginx, Render, Railway...) stands in front of the app:
# the number of proxies, for example 1. Leave it empty when there is none.
# Avoid "true": it trusts any X-Forwarded-For value, so anyone can fake their address.
TRUST_PROXY=
