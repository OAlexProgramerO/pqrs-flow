# Copy this file to .env and adjust the values if needed.

NODE_ENV=development
PORT=3000
DB_PATH=data/pqrs.db

# New requests (POST /api/pqrs) allowed per client address in each window.
SUBMIT_RATE_LIMIT_MAX=10
SUBMIT_RATE_LIMIT_WINDOW_MINUTES=15

# Only when a reverse proxy (Nginx, Render, Railway...) stands in front of the app:
# the number of proxies, for example 1. Leave it empty when there is none.
# Avoid "true": it trusts any X-Forwarded-For value, so anyone can fake their address.
TRUST_PROXY=

# Websites allowed to call the API from a browser, separated by commas.
# Leave it empty when the pages are served by this app (the normal case).
# Example: CORS_ORIGINS=https://citizens.example.com,http://localhost:5500
CORS_ORIGINS=

# Seconds a browser may keep styles, scripts and images (pages are always checked again).
# Empty means 0 in development and 3600 (one hour) when NODE_ENV=production.
STATIC_CACHE_SECONDS=

# ---- Staff area (v0.2.0) ----
# There are no default staff accounts. Create the first one with: npm run admin -- create
# (see the README). Never put a password in this file.

# A staff session ends after this many minutes without use, or after the maximum below.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Adds "Secure" to the session cookie, so the browser only sends it over HTTPS.
# Empty means true when NODE_ENV=production and false otherwise. Leave it on in production.
SESSION_COOKIE_SECURE=

# Staff login attempts allowed in each window: per client address and per account.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Attachments: keep files out of the web root, limit file sizes and how many are allowed.
ATTACHMENTS_STORAGE_DIR=data/attachments
ATTACHMENTS_MAX_FILE_SIZE=5242880
ATTACHMENTS_MAX_FILES_PER_REQUEST=3
ATTACHMENTS_MAX_AGGREGATE_SIZE=10485760
ATTACHMENTS_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.doc,.docx
ATTACHMENTS_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Email notifications are queued in the SQLite outbox and sent later when enabled.
# Leave EMAIL_ENABLED=false to keep the app local-only and avoid SMTP credentials.
EMAIL_ENABLED=false
EMAIL_FROM="PQRS Flow <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
