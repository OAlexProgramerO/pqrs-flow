diff --git a/backend/src/shutdown.js b/backend/src/shutdown.js
new file mode 100644
index 0000000..d51788b
--- /dev/null
+++ b/backend/src/shutdown.js
@@ -0,0 +1,109 @@
+/**
+ * Graceful shutdown of the HTTP server and the SQLite connection.
+ *
+ * - server: the http.Server returned by app.listen()
+ * - closeDatabase: closes the shared SQLite connection (closeDb of db/database.js)
+ * - timeoutMs: the longest the whole shutdown may take before the process is forced to stop
+ * - log, exit, setTimer, clearTimer: replaced in tests
+ *
+ * The returned function is idempotent: every call after the first returns the same promise and
+ * does nothing else. It resolves with the exit code (0 on a clean shutdown, 1 on any problem).
+ */
+export const SHUTDOWN_TIMEOUT_MS = 10_000;
+
+export function createShutdown({
+  server,
+  closeDatabase,
+  timeoutMs = SHUTDOWN_TIMEOUT_MS,
+  log = console,
+  exit = (code) => process.exit(code),
+  setTimer = setTimeout,
+  clearTimer = clearTimeout,
+}) {
+  let running;
+
+  // Stops accepting connections and waits for the requests that are still running
+  function closeServer() {
+    return new Promise((resolve, reject) => {
+      server.close((error) => {
+        // A server that is not listening any more has nothing left to close
+        if (error && error.code !== 'ERR_SERVER_NOT_RUNNING') reject(error);
+        else resolve();
+      });
+      // Keep-alive connections without a request would hold the server open for a minute
+      server.closeIdleConnections?.();
+    });
+  }
+
+  async function run(signal) {
+    log.log(`Received ${signal}, shutting down...`);
+
+    let finished = false;
+    let code;
+    let forceStop;
+    const forced = new Promise((resolve) => {
+      forceStop = resolve;
+    });
+
+    const timer = setTimer(() => {
+      if (finished) return;
+      finished = true;
+      log.error(`Shutdown took longer than ${timeoutMs} ms, forcing the process to stop.`);
+      server.closeAllConnections?.();
+      try {
+        closeDatabase();
+      } catch (error) {
+        log.error('Could not close the database:', error);
+      }
+      exit(1);
+      // Only reached when exit is replaced (tests): the caller must not wait for ever
+      forceStop(1);
+    }, timeoutMs);
+    // The timer must never be the only thing keeping the process alive
+    timer?.unref?.();
+
+    const closing = closeServer().then(
+      () => 0,
+      (error) => {
+        log.error('Could not close the HTTP server:', error);
+        return 1;
+      },
+    );
+    code = await Promise.race([closing, forced]);
+
+    // After a forced stop the timer already closed the database and ended the process
+    if (finished) return 1;
+
+    try {
+      closeDatabase();
+    } catch (error) {
+      code = 1;
+      log.error('Could not close the database:', error);
+    }
+
+    finished = true;
+    clearTimer(timer);
+    log.log('Shutdown complete.');
+    return code;
+  }
+
+  return function shutdown(signal = 'shutdown') {
+    running ??= run(signal);
+    return running;
+  };
+}
+
+/**
+ * Connects the shutdown to SIGINT and SIGTERM. The exit code is set, not forced: the process
+ * ends by itself once the server and the database are closed. Repeated signals are absorbed by
+ * the idempotent shutdown.
+ */
+export function installShutdownHandlers(shutdown, proc = process, signals = ['SIGINT', 'SIGTERM']) {
+  for (const signal of signals) {
+    proc.on(signal, () => {
+      shutdown(signal).then((code) => {
+        proc.exitCode = code;
+      });
+    });
+  }
+}
diff --git a/backend/tests/db-isolation.test.js b/backend/tests/db-isolation.test.js
new file mode 100644
index 0000000..5b0ae7a
--- /dev/null
+++ b/backend/tests/db-isolation.test.js
@@ -0,0 +1,79 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const backendDir = fileURLToPath(new URL('..', import.meta.url));
+const preload = path.join(backendDir, 'tests/helpers/isolate-db.js');
+
+// Runs a script in a child process that loads the preload exactly as `npm test` does,
+// starting without any DB_PATH so the preload has to pick its own temporary database.
+function runWithPreload(script) {
+  const env = { ...process.env };
+  delete env.DB_PATH;
+
+  return spawnSync(process.execPath, ['--import', preload, '--input-type=module', '-e', script], {
+    cwd: backendDir,
+    env,
+    encoding: 'utf8',
+  });
+}
+
+test('the preload does not load the database settings before a test sets DB_PATH', () => {
+  const chosen = path.join(os.tmpdir(), 'pqrs-order-check', 'chosen.db');
+  const script = `
+    process.env.DB_PATH = ${JSON.stringify(chosen)};
+    const { env } = await import('./src/config/env.js');
+    console.log(env.dbPath);
+  `;
+  const result = runWithPreload(script);
+
+  assert.equal(result.status, 0, result.stderr);
+  // If the preload had imported the database module first, the settings would already hold the
+  // preload's own folder and the path chosen by the test would be ignored.
+  assert.equal(result.stdout.trim(), chosen);
+});
+
+test('the preload gives a process its own temporary database and removes it afterwards', () => {
+  const script = `
+    console.log(process.env.DB_PATH);
+    const { openDatabase } = await import('./src/db/database.js');
+    const db = openDatabase({ filename: process.env.DB_PATH });
+    db.prepare('INSERT INTO case_counters (year, last_value) VALUES (2000, 1)').run();
+    db.close();
+  `;
+  const result = runWithPreload(script);
+  assert.equal(result.status, 0, result.stderr);
+
+  const dbPath = result.stdout.trim().split('\n')[0];
+  assert.ok(dbPath.startsWith(os.tmpdir() + path.sep));
+  assert.notEqual(path.resolve(dbPath), path.resolve(backendDir, '../data/pqrs.db'));
+  for (const suffix of ['', '-wal', '-shm']) {
+    assert.equal(fs.existsSync(dbPath + suffix), false, `${suffix || 'database'} was left behind`);
+  }
+  assert.equal(fs.existsSync(path.dirname(dbPath)), false, 'the temporary folder was left behind');
+});
+
+test('the shared connection opened during a run is closed and its files are removed', () => {
+  const script = `
+    console.log(process.env.DB_PATH);
+    const { getDb } = await import('./src/db/database.js');
+    getDb().prepare('INSERT INTO case_counters (year, last_value) VALUES (2000, 1)').run();
+  `;
+  const result = runWithPreload(script);
+  assert.equal(result.status, 0, result.stderr);
+
+  const dbPath = result.stdout.trim().split('\n')[0];
+  assert.equal(fs.existsSync(path.dirname(dbPath)), false, 'the temporary folder was left behind');
+});
+
+test('the preload helper keeps the database module out of its static imports', () => {
+  const source = fs.readFileSync(preload, 'utf8');
+
+  assert.doesNotMatch(source, /^\s*import[^;]*['"][^'"]*db\/database[^'"]*['"]/m);
+  assert.doesNotMatch(source, /^\s*import[^;]*['"][^'"]*config\/env[^'"]*['"]/m);
+  assert.match(source, /await import\(['"][^'"]*db\/database\.js['"]\)/);
+});
